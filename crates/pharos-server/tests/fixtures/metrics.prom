# HELP pharos_dns_requests_total Counter of DNS requests made per zone, protocol and family.
# TYPE pharos_dns_requests_total counter
pharos_dns_requests_total{family="1",proto="udp",server="dns://:53",type="A",view="",zone="example.\n"} 1
