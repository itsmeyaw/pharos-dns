# HELP pharos_dns_responses_total Counter of response status codes.
# TYPE pharos_dns_responses_total counter
pharos_dns_responses_total{plugin="",rcode="NOERROR",server="dns://:53",view="",zone="example.\n"} 1
# HELP pharos_panics_total A metrics that counts the number of panics.
# TYPE pharos_panics_total counter
pharos_panics_total 0
